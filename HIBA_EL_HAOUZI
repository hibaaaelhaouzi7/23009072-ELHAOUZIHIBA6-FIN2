      "cell_type": "markdown",
      "source": [
        "3. Préparation des données"
      ],
      "metadata": {
        "id": "BimjE2mlsWtt"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Suppression des doublons\n",
        "df = df.drop_duplicates().copy()\n",
        "\n",
        "# Suppression des colonnes qui risquent de révéler directement\n",
        "# le choix final ou des informations redondantes\n",
        "X = df.drop(columns=[\n",
        "    'Avenue',\n",
        "    'Mutual_Funds', 'Equity_Market', 'Debentures',\n",
        "    'Government_Bonds', 'Fixed_Deposits', 'PPF', 'Gold'\n",
        "])\n",
        "\n",
        "y = df['Avenue']\n",
        "\n",
        "# Séparation numérique / catégorielle\n",
        "numeric_features = X.select_dtypes(include=np.number).columns.tolist()\n",
        "categorical_features = X.select_dtypes(include='object').columns.tolist()\n",
        "\n",
        "# Prétraitement\n",
        "numeric_transformer = Pipeline([\n",
        "    ('imputer', SimpleImputer(strategy='median')),\n",
        "    ('scaler', StandardScaler())\n",
        "])\n",
        "\n",
        "categorical_transformer = Pipeline([\n",
        "    ('imputer', SimpleImputer(strategy='most_frequent')),\n",
        "    ('encoder', OneHotEncoder(handle_unknown='ignore'))\n",
        "])\n",
        "\n",
        "preprocessor = ColumnTransformer([\n",
        "    ('num', numeric_transformer, numeric_features),\n",
        "    ('cat', categorical_transformer, categorical_features)\n",
        "])\n"
      ],
      "metadata": {
        "id": "a0d33klYrcFG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "4. Découpage des données"
      ],
      "metadata": {
        "id": "DiySHrCFsceH"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.25,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "print(\"Taille entraînement :\", X_train.shape)\n",
        "print(\"Taille test :\", X_test.shape)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "E4tVI6JprlnS",
        "outputId": "3a12cd93-bfb4-46dd-cb0f-9de0610ee249"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Taille entraînement : (30, 16)\n",
            "Taille test : (10, 16)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "5. Modèle Random Forest"
      ],
      "metadata": {
        "id": "OiwJBClhsg8x"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "model = Pipeline([\n",
        "    ('preprocessing', preprocessor),\n",
        "    ('classifier', RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        max_depth=3,\n",
        "        random_state=42,\n",
        "        class_weight='balanced'\n",
        "    ))\n",
        "])\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "print(\"Accuracy :\", accuracy_score(y_test, y_pred))\n",
        "print(classification_report(y_test, y_pred, zero_division=0))\n"
      ],
